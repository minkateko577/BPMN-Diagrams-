    <bpmn:messageFlow id="Msg_1" name="Order details" sourceRef="Task_1" targetRef="StartEvent_2" />
    <bpmn:messageFlow id="Msg_2" name="Order confirmation" sourceRef="Task_4" targetRef="CatchEvent_1" />
    <bpmn:messageFlow id="Msg_3" name="Inventory check request" sourceRef="Task_5" targetRef="StartEvent_5" />
    <bpmn:messageFlow id="Msg_4" name="Return request" sourceRef="Task_2" targetRef="StartEvent_3" />
