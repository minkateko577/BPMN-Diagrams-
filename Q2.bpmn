      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CatchEvent_2" name="Receive shipment /&#10;tracking notification">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_1" name="Wants to return&#10;an item?" />
    <bpmn:task id="Task_2" name="Submit return&#10;request" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:endEvent id="EndEvent_2" name="End" />
    <bpmn:intermediateCatchEvent id="CatchEvent_3" name="Receive refund&#10;confirmation">
